---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: 'en' | 'ar';
}

const {
  title = 'RestoPOS — Business Software & Custom App Development',
  description = 'RestoPOS builds business management software and custom applications — ZATCA Phase 2 POS and billing, branded restaurant ordering apps, and tailored iOS, Android and web software for businesses in Saudi Arabia and beyond.',
  image = '/og-image.png',
  lang = 'en',
} = Astro.props;

const dir = lang === 'ar' ? 'rtl' : 'ltr';

// Canonical + absolute OG image URL (Astro.site = https://restopos.store).
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;

// hreflang alternates — map the current path to its EN / AR counterpart.
const base = Astro.url.pathname.replace(/^\/ar(?=\/|$)/, '') || '/';
const enPath = base;
const arPath = base === '/' ? '/ar/' : `/ar${base}`;
const enHref = Astro.site ? new URL(enPath, Astro.site).href : enPath;
const arHref = Astro.site ? new URL(arPath, Astro.site).href : arPath;
// URL to the other language, for the in-nav switcher.
const altLangPath = lang === 'ar' ? enPath : arPath;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'RestoPOS',
  url: 'https://restopos.store',
  logo: 'https://restopos.store/favicon.svg',
  description:
    'Business management software and custom app development — ZATCA Phase 2 POS, restaurant ordering apps, and tailored software.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Iritty, Kannur',
    addressRegion: 'Kerala',
    addressCountry: 'IN',
  },
};
---

<!doctype html>
<html lang={lang} dir={dir} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="ar" href={arHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="RestoPOS" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} is:inline />
  </head>
  <body class="flex min-h-screen flex-col">
    <div id="scroll-progress" aria-hidden="true"></div>
    <Navbar lang={lang} altLangPath={altLangPath} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Reveal-on-scroll: [data-reveal] elements fade up when they enter view.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));

      // Count-up: [data-count] animates from 0 when scrolled into view.
      const arabicDigits: Record<string, string> = { '0':'٠','1':'١','2':'٢','3':'٣','4':'٤','5':'٥','6':'٦','7':'٧','8':'٨','9':'٩','.':'٫' };
      const countObs = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          countObs.unobserve(el);
          const target = parseFloat(el.dataset.count || '0');
          const suffix = el.dataset.suffix || '';
          const arabic = el.dataset.arabic === 'true';
          const decimals = target % 1 !== 0 ? 1 : 0;
          const start = performance.now();
          const dur = reduceMotion ? 0 : 1400;
          const fmt = (v: number) => {
            let s = v.toFixed(decimals);
            if (arabic) s = s.replace(/[0-9.]/g, (d) => arabicDigits[d] || d);
            return s + suffix;
          };
          const step = (t: number) => {
            const k = dur ? Math.min(1, (t - start) / dur) : 1;
            const eased = 1 - Math.pow(1 - k, 3);
            el.textContent = fmt(target * eased);
            if (k < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }
      }, { threshold: 0.6 });
      document.querySelectorAll('[data-count]').forEach((el) => countObs.observe(el));

      // Scroll progress bar + parallax on [data-parallax] elements.
      const bar = document.getElementById('scroll-progress');
      const parallaxEls = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));

      // Scroll-linked zoom: each [data-zoom] (and .zoom-frame .zoom-media)
      // scales with its position in the viewport — the "live zoom" effect.
      const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
      const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
      const zoomEls = Array.from(
        document.querySelectorAll<HTMLElement>('[data-zoom], .zoom-frame')
      ).map((el) => ({
        el,
        target: (el.classList.contains('zoom-frame')
          ? el.querySelector<HTMLElement>('.zoom-media')
          : el) as HTMLElement | null,
        mode: el.dataset.zoom || (el.classList.contains('zoom-frame') ? 'through' : 'in'),
      }));

      const applyZoom = () => {
        const vh = window.innerHeight;
        for (const { el, target, mode } of zoomEls) {
          if (!target) continue;
          const rect = el.getBoundingClientRect();
          // p: 0 when the element's top hits the viewport bottom, 1 when its
          // bottom hits the viewport top — how far it has crossed the screen.
          const p = clamp((vh - rect.top) / (vh + rect.height), 0, 1);
          let scale = 1;
          if (mode === 'through') {
            const from = parseFloat(el.dataset.zoomFrom || '0.96');
            const to = parseFloat(el.dataset.zoomTo || '1.08');
            scale = from + (to - from) * p;
          } else if (mode === 'focus') {
            const peak = parseFloat(el.dataset.zoomTo || '1.06');
            const tri = 1 - Math.abs(p - 0.5) * 2; // 0 → 1 → 0, peak centred
            scale = 1 + (peak - 1) * easeOut(clamp(tri, 0, 1));
          } else {
            const from = parseFloat(el.dataset.zoomFrom || '0.9');
            const to = parseFloat(el.dataset.zoomTo || '1');
            scale = from + (to - from) * easeOut(clamp(p / 0.5, 0, 1));
          }
          target.style.transform = `scale(${scale.toFixed(4)})`;
        }
      };

      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const h = document.documentElement;
          const max = h.scrollHeight - h.clientHeight;
          if (bar) bar.style.transform = `scaleX(${max > 0 ? window.scrollY / max : 0})`;
          if (!reduceMotion) {
            for (const el of parallaxEls) {
              const speed = parseFloat(el.dataset.parallax || '0.15');
              el.style.transform = `translateY(${window.scrollY * speed}px)`;
            }
            applyZoom();
          }
          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>
