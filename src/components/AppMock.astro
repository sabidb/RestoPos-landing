---
// Illustrative coded mock of a branded restaurant ordering app — represents
// the kind of custom app we build. Not a real client; pure markup, no data.
---
<div
  role="img"
  aria-label="Illustration of a branded restaurant ordering app built by RestoPOS"
  class="overflow-hidden rounded-[1.8rem] border border-hairline bg-charcoal"
>
  <!-- status bar -->
  <div class="flex items-center justify-between px-4 pt-3 pb-1 font-mono text-[9px] text-bone/35">
    <span>9:41</span>
    <span>● ● ●</span>
  </div>
  <!-- app header -->
  <div class="flex items-center gap-2.5 px-4 py-3">
    <span class="brand-gradient flex size-7 items-center justify-center rounded-lg text-[11px] font-bold text-white">R</span>
    <div class="min-w-0">
      <p class="whitespace-nowrap text-[11px] font-semibold text-bone">Your Restaurant</p>
      <p class="font-mono text-[8px] text-bone/35">your branded app</p>
    </div>
    <span class="ml-auto shrink-0 rounded-full border border-leaf-bright/30 bg-leaf/15 px-2 py-0.5 text-[8px] font-semibold text-leaf-bright">OPEN</span>
  </div>
  <!-- menu item -->
  <div class="px-4">
    <div class="rounded-xl border border-hairline bg-bone/[0.03] p-3">
      <div class="flex items-center justify-between gap-2">
        <div class="min-w-0">
          <p class="whitespace-nowrap text-[11px] font-semibold text-bone">Broast Platter</p>
          <p class="mt-0.5 whitespace-nowrap text-[9px] text-bone/40">Half · rice &amp; sauce</p>
        </div>
        <span class="shrink-0 font-mono text-[11px] font-semibold text-gold">SAR 29</span>
      </div>
    </div>
    <div class="mt-2 rounded-xl border border-hairline bg-bone/[0.03] p-3">
      <div class="flex items-center justify-between gap-2">
        <div class="min-w-0">
          <p class="whitespace-nowrap text-[11px] font-semibold text-bone">Karak Chai</p>
          <p class="mt-0.5 whitespace-nowrap text-[9px] text-bone/40">Regular</p>
        </div>
        <span class="shrink-0 font-mono text-[11px] font-semibold text-gold">SAR 6</span>
      </div>
    </div>
  </div>
  <!-- order type + cta -->
  <div class="px-4 pb-5 pt-4">
    <div class="flex gap-1 font-mono text-[8px]">
      <span class="whitespace-nowrap rounded-md border border-gold/40 bg-gold/10 px-1.5 py-1 text-gold">Delivery</span>
      <span class="whitespace-nowrap rounded-md border border-hairline px-1.5 py-1 text-bone/45">Pickup</span>
      <span class="whitespace-nowrap rounded-md border border-hairline px-1.5 py-1 text-bone/45">Dine&#8209;in</span>
    </div>
    <div class="brand-gradient mt-3 flex items-center justify-between gap-2 rounded-xl px-3.5 py-2.5 text-[10px] font-semibold text-white">
      <span class="whitespace-nowrap">Place order</span>
      <span class="whitespace-nowrap font-mono">SAR 35.00 →</span>
    </div>
  </div>
</div>
