---
// Illustrative coded mock of a branded restaurant ordering app — represents
// the kind of custom app we build. Not a real client; pure markup, no data.
---
<div
  role="img"
  aria-label="Illustration of a branded restaurant ordering app built by RestoPOS"
  class="overflow-hidden rounded-[1.8rem] border border-hairline bg-charcoal"
>
  <!-- status bar -->
  <div class="flex items-center justify-between px-5 pt-3 pb-1 font-mono text-[9px] text-bone/35">
    <span>9:41</span>
    <span>● ● ●</span>
  </div>
  <!-- app header -->
  <div class="flex items-center gap-2.5 px-5 py-3">
    <span class="brand-gradient flex size-7 items-center justify-center rounded-lg text-[11px] font-bold text-white">R</span>
    <div>
      <p class="text-[11px] font-semibold text-bone">Your Restaurant</p>
      <p class="font-mono text-[8px] text-bone/35">your branded app</p>
    </div>
    <span class="ml-auto rounded-full border border-leaf-bright/30 bg-leaf/15 px-2 py-0.5 text-[8px] font-semibold text-leaf-bright">OPEN</span>
  </div>
  <!-- menu item -->
  <div class="px-5">
    <div class="rounded-xl border border-hairline bg-bone/[0.03] p-3">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-[11px] font-semibold text-bone">Grilled Broast Platter</p>
          <p class="mt-0.5 text-[9px] text-bone/40">Half · with rice &amp; sauce</p>
        </div>
        <span class="font-mono text-[11px] font-semibold text-gold">SAR 29</span>
      </div>
    </div>
    <div class="mt-2 rounded-xl border border-hairline bg-bone/[0.03] p-3">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-[11px] font-semibold text-bone">Karak Chai</p>
          <p class="mt-0.5 text-[9px] text-bone/40">Regular</p>
        </div>
        <span class="font-mono text-[11px] font-semibold text-gold">SAR 6</span>
      </div>
    </div>
  </div>
  <!-- order type + cta -->
  <div class="px-5 pb-5 pt-4">
    <div class="flex gap-1.5 font-mono text-[9px]">
      <span class="rounded-md border border-gold/40 bg-gold/10 px-2 py-1 text-gold">Delivery</span>
      <span class="rounded-md border border-hairline px-2 py-1 text-bone/45">Pickup</span>
      <span class="rounded-md border border-hairline px-2 py-1 text-bone/45">Dine-in</span>
    </div>
    <div class="brand-gradient mt-3 flex items-center justify-between rounded-xl px-4 py-2.5 text-[11px] font-semibold text-white">
      <span>Place order</span>
      <span class="font-mono">SAR 35.00 →</span>
    </div>
  </div>
</div>
