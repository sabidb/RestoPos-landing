---
import LogoMark from './LogoMark.astro';
import { APP_URL } from '../config';

interface Props {
  lang?: 'en' | 'ar';
  altLangPath?: string;
}
const { lang = 'en', altLangPath = '/ar/' } = Astro.props;
const ar = lang === 'ar';
const p = ar ? '/ar' : ''; // route prefix

const t = ar
  ? { home: 'الرئيسية', solutions: 'الحلول', appDev: 'تطوير التطبيقات', about: 'من نحن', contact: 'تواصل معنا', register: 'سجّل الآن', demo: 'اطلب عرضاً تجريبياً', altLabel: 'English' }
  : { home: 'Home', solutions: 'Solutions', appDev: 'App Development', about: 'About Us', contact: 'Contact', register: 'Register Now', demo: 'Request a Demo', altLabel: 'العربية' };

const solutions = [
  { href: '/features', label: ar ? 'منصة RestoPOS' : 'RestoPOS Platform', desc: ar ? 'نقاط البيع والفوترة والفاتورة الإلكترونية' : 'POS, billing & ZATCA e-invoicing' },
  { href: '/ordering', label: ar ? 'تطبيق طلبات المطعم' : 'Restaurant Ordering App', desc: ar ? 'تطبيقك الخاص بعلامتك التجارية' : 'Your own branded customer app' },
  { href: '/chains', label: ar ? 'أنظمة متعددة الفروع' : 'Multi-Branch Systems', desc: ar ? 'أدِر كل فروعك من حساب واحد' : 'Run every branch from one account' },
  { href: '/pricing', label: ar ? 'الأسعار' : 'Pricing', desc: ar ? 'الباقات وطلب عرض سعر' : 'Plans & request a quote' },
];

const links = [
  { href: '/custom-development', label: t.appDev },
  { href: '/about', label: t.about },
  { href: '/contact', label: t.contact },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === (p + href).replace(/\/$/, '');
const homeHref = p ? p + '/' : '/';
const solutionsActive = solutions.some((s) => isActive(s.href));
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-hairline bg-charcoal/85 backdrop-blur-md">
  <nav aria-label="Main" class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6 md:px-8">
    <a href={homeHref} class="group flex items-center gap-2.5" aria-label="RestoPOS home">
      <LogoMark class="ease-out-quad size-8 rounded-lg text-[15px] transition-transform duration-300 group-hover:scale-105" />
      <span class="text-[15px] font-semibold tracking-tight text-bone">
        Resto<span class="text-gold">POS</span>
      </span>
    </a>

    <div class="hidden items-center gap-7 lg:flex">
      <a href={homeHref} class:list={['ease-out-quad text-[13px] tracking-wide transition-colors duration-300', isActive('/') ? 'text-gold' : 'text-bone/70 hover:text-bone']} aria-current={isActive('/') ? 'page' : undefined}>{t.home}</a>

      <div class="group relative" data-dropdown>
        <button type="button" class:list={['ease-out-quad flex items-center gap-1 text-[13px] tracking-wide transition-colors duration-300', solutionsActive ? 'text-gold' : 'text-bone/70 hover:text-bone']} aria-haspopup="true" aria-expanded="false" data-dropdown-trigger>
          {t.solutions}
          <span aria-hidden="true" class="ease-out-quad text-[10px] transition-transform duration-300 group-hover:rotate-180 group-focus-within:rotate-180">▾</span>
        </button>
        <div class="ease-out-quad invisible absolute top-full z-50 w-80 translate-y-1 pt-3 opacity-0 transition-all duration-300 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 ltr:left-1/2 ltr:-translate-x-1/2 rtl:right-1/2 rtl:translate-x-1/2" data-dropdown-menu>
          <div class="overflow-hidden rounded-2xl border border-hairline bg-charcoal-soft/95 p-2 shadow-gold backdrop-blur-xl">
            {
              solutions.map((s) => (
                <a href={p + s.href} class="ease-out-quad block rounded-xl px-4 py-3 transition-colors duration-200 hover:bg-charcoal">
                  <span class="block text-sm font-medium text-bone">{s.label}</span>
                  <span class="block text-xs text-bone/45">{s.desc}</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>

      {links.map(({ href, label }) => (
        <a href={p + href} class:list={['ease-out-quad text-[13px] tracking-wide transition-colors duration-300', isActive(href) ? 'text-gold' : 'text-bone/70 hover:text-bone']} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
      ))}
    </div>

    <div class="hidden items-center gap-4 lg:flex">
      <a href={altLangPath} class="ease-out-quad rounded-md border border-hairline px-2.5 py-1 text-[12px] font-medium tracking-wide text-bone/70 transition-colors duration-300 hover:border-gold/40 hover:text-gold" hreflang={ar ? 'en' : 'ar'}>{t.altLabel}</a>
      <a href={p + '/contact'} class="ease-out-quad rounded-full border border-gold/40 bg-gold/10 px-4 py-2 text-[13px] font-medium tracking-wide text-gold shadow-[inset_0_1px_0_rgba(220,192,138,0.15)] backdrop-blur-md transition-all duration-300 hover:bg-gold hover:text-charcoal">{t.demo}</a>
      <a href={APP_URL} class="brand-gradient ease-out-quad rounded-full px-5 py-2 text-[13px] font-semibold tracking-wide text-white shadow-[0_6px_20px_rgba(76,122,82,0.3)] transition duration-300 hover:brightness-110">{t.register}</a>
    </div>

    <button id="menu-toggle" class="flex h-8 w-8 flex-col items-center justify-center gap-1.5 text-bone lg:hidden" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
      <span class="menu-line ease-out-quad block h-px w-5 bg-bone transition-transform duration-300"></span>
      <span class="menu-line ease-out-quad block h-px w-5 bg-bone transition-opacity duration-300"></span>
      <span class="menu-line ease-out-quad block h-px w-5 bg-bone transition-transform duration-300"></span>
    </button>
  </nav>

  <div id="mobile-menu" hidden class="max-h-[calc(100vh-4rem)] overflow-y-auto border-b border-hairline bg-charcoal lg:hidden">
    <div class="flex flex-col gap-1 px-6 py-5">
      <a href={homeHref} class="py-2 text-sm text-bone/80">{t.home}</a>
      <span class="mt-2 text-[11px] uppercase tracking-widest text-bone/40">{t.solutions}</span>
      {solutions.map((s) => (
        <a href={p + s.href} class="py-2 ltr:pl-3 rtl:pr-3 text-sm text-bone/80">{s.label}</a>
      ))}
      <div class="my-1 h-px bg-hairline"></div>
      {links.map(({ href, label }) => (
        <a href={p + href} class="py-2 text-sm text-bone/80">{label}</a>
      ))}
      <div class="mt-2 flex flex-wrap items-center gap-3">
        <a href={APP_URL} class="brand-gradient inline-flex items-center justify-center rounded-full px-5 py-2.5 text-sm font-semibold text-white">{t.register}</a>
        <a href={p + '/contact'} class="inline-flex items-center justify-center rounded-full border border-gold/40 bg-gold/10 px-5 py-2.5 text-sm font-medium text-gold">{t.demo}</a>
        <a href={altLangPath} class="rounded-md border border-hairline px-3 py-2 text-sm text-bone/70" hreflang={ar ? 'en' : 'ar'}>{t.altLabel}</a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const lines = toggle?.querySelectorAll('.menu-line');

  toggle?.addEventListener('click', () => {
    const open = menu!.hidden;
    menu!.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    if (lines) {
      (lines[0] as HTMLElement).style.transform = open ? 'rotate(45deg) translateY(6.5px)' : '';
      (lines[1] as HTMLElement).style.opacity = open ? '0' : '';
      (lines[2] as HTMLElement).style.transform = open ? 'rotate(-45deg) translateY(-6.5px)' : '';
    }
  });

  for (const dd of document.querySelectorAll<HTMLElement>('[data-dropdown]')) {
    const trigger = dd.querySelector<HTMLButtonElement>('[data-dropdown-trigger]');
    const set = (v: boolean) => trigger?.setAttribute('aria-expanded', String(v));
    dd.addEventListener('pointerenter', () => set(true));
    dd.addEventListener('pointerleave', () => set(false));
    dd.addEventListener('focusin', () => set(true));
    dd.addEventListener('focusout', (e) => {
      if (!dd.contains(e.relatedTarget as Node)) set(false);
    });
  }
</script>
