---
import LogoMark from './LogoMark.astro';
import Bi from './Bi.astro';

const year = new Date().getFullYear();
---

<footer class="mt-32 border-t border-hairline">
  <div class="mx-auto flex max-w-6xl flex-col justify-between gap-10 px-6 py-14 md:flex-row md:px-8">
    <div class="max-w-xs">
      <div class="mb-4 flex items-center gap-2.5">
        <LogoMark class="size-7 rounded-md text-[13px]" />
        <span class="text-[15px] font-semibold tracking-tight text-bone">
          Resto<span class="text-gold">POS</span>
        </span>
      </div>
      <p class="text-sm leading-relaxed text-bone/50">
        <Bi
          en="ZATCA Phase 2-compliant billing for any business in Saudi Arabia. Built for precision, priced for growth."
          ar="فوترة متوافقة مع المرحلة الثانية من هيئة الزكاة لكل الأعمال في السعودية. مبنية بدقة، ومسعّرة للنمو."
        />
      </p>
    </div>

    <div class="grid grid-cols-2 gap-10 text-sm sm:grid-cols-3">
      <div class="flex flex-col gap-3">
        <span class="text-[11px] uppercase tracking-widest text-bone/40"><Bi en="Product" ar="المنتج" /></span>
        <a href="/features" class="text-bone/70 transition-colors duration-300 hover:text-gold"><Bi en="Features" ar="المميزات" /></a>
        <a href="/pricing" class="text-bone/70 transition-colors duration-300 hover:text-gold"><Bi en="Pricing" ar="الأسعار" /></a>
      </div>
      <div class="flex flex-col gap-3">
        <span class="text-[11px] uppercase tracking-widest text-bone/40"><Bi en="Company" ar="الشركة" /></span>
        <a href="/contact" class="text-bone/70 transition-colors duration-300 hover:text-gold"><Bi en="Contact" ar="تواصل معنا" /></a>
      </div>
      <div class="flex flex-col gap-3">
        <span class="text-[11px] uppercase tracking-widest text-bone/40"><Bi en="Compliance" ar="الامتثال" /></span>
        <span class="text-bone/70"><Bi en="ZATCA Phase 2" ar="هيئة الزكاة — المرحلة الثانية" /></span>
        <span class="text-bone/70"><Bi en="Fatoora Integrated" ar="متكامل مع فاتورة" /></span>
      </div>
    </div>
  </div>

  <div class="border-t border-hairline">
    <div
      class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-6 py-5 sm:flex-row md:px-8"
    >
      <p class="text-xs text-bone/30">© {year} RestoPOS. <Bi en="Makkah, Saudi Arabia." ar="مكة المكرمة، السعودية." /></p>
      <p class="text-xs text-bone/30"><Bi en="Precision billing, quietly done." ar="فوترة دقيقة، تُنجز بهدوء." /></p>
    </div>
  </div>
</footer>
