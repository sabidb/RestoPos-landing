---
import LogoMark from './LogoMark.astro';
import { APP_URL } from '../config';

const year = new Date().getFullYear();

const cols = [
  {
    title: 'Products',
    links: [
      { label: 'RestoPOS Platform', href: '/features' },
      { label: 'Restaurant Ordering App', href: '/ordering' },
      { label: 'Multi-Branch Systems', href: '/chains' },
      { label: 'Pricing', href: '/pricing' },
    ],
  },
  {
    title: 'Services',
    links: [
      { label: 'Custom Mobile Apps', href: '/custom-development' },
      { label: 'Web Development', href: '/custom-development' },
      { label: 'Business Software', href: '/custom-development' },
      { label: 'API & Integrations', href: '/custom-development' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About Us', href: '/about' },
      { label: 'Contact', href: '/contact' },
    ],
  },
];
---

<footer class="mt-32 border-t border-hairline">
  <div class="mx-auto grid max-w-6xl gap-12 px-6 py-16 md:grid-cols-[1.4fr_1fr_1fr_1fr] md:px-8">
    <div class="max-w-xs">
      <div class="mb-4 flex items-center gap-2.5">
        <LogoMark class="size-7 rounded-md text-[13px]" />
        <span class="text-[15px] font-semibold tracking-tight text-bone">
          Resto<span class="text-gold">POS</span>
        </span>
      </div>
      <p class="text-sm leading-relaxed text-bone/50">
        Business management software and custom app development for restaurants and growing
        businesses — ZATCA Phase 2 billing, ordering apps, and software built around your workflow.
      </p>

      <div class="mt-6">
        <span class="text-[11px] uppercase tracking-widest text-bone/40">Head Office</span>
        <address class="mt-2 text-sm not-italic leading-relaxed text-bone/60">
          Iritty, Kannur<br />
          Kerala, India
        </address>
      </div>
    </div>

    {
      cols.map((c) => (
        <div class="flex flex-col gap-3 text-sm">
          <span class="text-[11px] uppercase tracking-widest text-bone/40">{c.title}</span>
          {c.links.map((l) => (
            <a href={l.href} class="text-bone/70 transition-colors duration-300 hover:text-gold">
              {l.label}
            </a>
          ))}
        </div>
      ))
    }
  </div>

  <div class="border-t border-hairline">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-6 py-5 sm:flex-row md:px-8">
      <p class="text-xs text-bone/30">© {year} RestoPOS. Iritty, Kannur, Kerala, India.</p>
      <div class="flex items-center gap-5 text-xs text-bone/40">
        <a href="/privacy" class="transition-colors duration-300 hover:text-bone/70">Privacy Policy</a>
        <a href="/terms" class="transition-colors duration-300 hover:text-bone/70">Terms of Service</a>
        <a href={APP_URL} class="transition-colors duration-300 hover:text-bone/70">Client Login</a>
      </div>
    </div>
  </div>
</footer>
