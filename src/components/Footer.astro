---
import LogoMark from './LogoMark.astro';
import { APP_URL } from '../config';

interface Props {
  lang?: 'en' | 'ar';
}
const { lang = 'en' } = Astro.props;
const ar = lang === 'ar';
const p = ar ? '/ar' : '';

const year = new Date().getFullYear();

const t = ar
  ? {
      blurb: 'برمجيات إدارة الأعمال وتطوير التطبيقات المخصصة للمطاعم والأعمال النامية — فوترة متوافقة مع المرحلة الثانية من ZATCA، تطبيقات طلب، وبرمجيات مبنية حول طريقة عملك.',
      office: 'المقر الرئيسي',
      addr1: 'إيريتي، كانور',
      addr2: 'ولاية كيرالا، الهند',
      rights: `© ${year} RestoPOS. إيريتي، كانور، كيرالا، الهند.`,
      privacy: 'سياسة الخصوصية',
      terms: 'شروط الخدمة',
      login: 'دخول العملاء',
    }
  : {
      blurb: 'Business management software and custom app development for restaurants and growing businesses — ZATCA Phase 2 billing, ordering apps, and software built around your workflow.',
      office: 'Head Office',
      addr1: 'Iritty, Kannur',
      addr2: 'Kerala, India',
      rights: `© ${year} RestoPOS. Iritty, Kannur, Kerala, India.`,
      privacy: 'Privacy Policy',
      terms: 'Terms of Service',
      login: 'Client Login',
    };

const cols = ar
  ? [
      { title: 'المنتجات', links: [ { label: 'منصة RestoPOS', href: '/features' }, { label: 'تطبيق طلبات المطعم', href: '/ordering' }, { label: 'أنظمة متعددة الفروع', href: '/chains' }, { label: 'الأسعار', href: '/pricing' } ] },
      { title: 'الخدمات', links: [ { label: 'تطبيقات جوال مخصصة', href: '/custom-development' }, { label: 'تطوير الويب', href: '/custom-development' }, { label: 'برمجيات الأعمال', href: '/custom-development' }, { label: 'واجهات برمجية وتكاملات', href: '/custom-development' } ] },
      { title: 'الشركة', links: [ { label: 'من نحن', href: '/about' }, { label: 'تواصل معنا', href: '/contact' } ] },
    ]
  : [
      { title: 'Products', links: [ { label: 'RestoPOS Platform', href: '/features' }, { label: 'Restaurant Ordering App', href: '/ordering' }, { label: 'Multi-Branch Systems', href: '/chains' }, { label: 'Pricing', href: '/pricing' } ] },
      { title: 'Services', links: [ { label: 'Custom Mobile Apps', href: '/custom-development' }, { label: 'Web Development', href: '/custom-development' }, { label: 'Business Software', href: '/custom-development' }, { label: 'API & Integrations', href: '/custom-development' } ] },
      { title: 'Company', links: [ { label: 'About Us', href: '/about' }, { label: 'Contact', href: '/contact' } ] },
    ];
---

<footer class="mt-32 border-t border-hairline">
  <div class="mx-auto grid max-w-6xl gap-12 px-6 py-16 md:grid-cols-[1.4fr_1fr_1fr_1fr] md:px-8">
    <div class="max-w-xs">
      <div class="mb-4 flex items-center gap-2.5">
        <LogoMark class="size-7 rounded-md text-[13px]" />
        <span class="text-[15px] font-semibold tracking-tight text-bone">
          Resto<span class="text-gold">POS</span>
        </span>
      </div>
      <p class="text-sm leading-relaxed text-bone/50">{t.blurb}</p>

      <div class="mt-6">
        <span class="text-[11px] uppercase tracking-widest text-bone/40">{t.office}</span>
        <address class="mt-2 text-sm not-italic leading-relaxed text-bone/60">
          {t.addr1}<br />
          {t.addr2}
        </address>
      </div>
    </div>

    {
      cols.map((c) => (
        <div class="flex flex-col gap-3 text-sm">
          <span class="text-[11px] uppercase tracking-widest text-bone/40">{c.title}</span>
          {c.links.map((l) => (
            <a href={p + l.href} class="text-bone/70 transition-colors duration-300 hover:text-gold">{l.label}</a>
          ))}
        </div>
      ))
    }
  </div>

  <div class="border-t border-hairline">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-6 py-5 sm:flex-row md:px-8">
      <p class="text-xs text-bone/30">{t.rights}</p>
      <div class="flex items-center gap-5 text-xs text-bone/40">
        <a href={p + '/privacy'} class="transition-colors duration-300 hover:text-bone/70">{t.privacy}</a>
        <a href={p + '/terms'} class="transition-colors duration-300 hover:text-bone/70">{t.terms}</a>
        <a href={APP_URL} class="transition-colors duration-300 hover:text-bone/70">{t.login}</a>
      </div>
    </div>
  </div>
</footer>
