---
import Layout from '../layouts/Layout.astro';
import DemoCta from '../components/DemoCta.astro';
import DashboardPreview from '../components/DashboardPreview.astro';
import AppMock from '../components/AppMock.astro';
import { APP_URL } from '../config';

// Eight things we build. Icons are inline SVG (no emoji) for a cleaner B2B feel.
const build = [
  { t: 'POS & Billing Solutions', d: 'ZATCA Phase 2 point of sale with signed, QR-coded invoices and Fatoora reporting.', href: '/features' },
  { t: 'Custom iOS & Android Apps', d: 'Native mobile apps built around your brand and your operation.', href: '/custom-development' },
  { t: 'Online Ordering Platforms', d: 'Your own branded delivery, pickup and dine-in ordering app.', href: '/ordering' },
  { t: 'Restaurant Management', d: 'Menus, kitchen tickets, staff roles and daily closes in one system.', href: '/features' },
  { t: 'Multi-Branch Systems', d: 'Run every branch under one account with per-branch VAT isolation.', href: '/chains' },
  { t: 'Custom Admin Dashboards', d: 'Control panels and reporting built for how your business actually runs.', href: '/custom-development' },
  { t: 'Business Websites', d: 'Fast, modern marketing sites and web apps for growing businesses.', href: '/custom-development' },
  { t: 'API & Integrations', d: 'Connect RestoPOS or your systems to the tools you already use.', href: '/custom-development' },
];

const why = [
  { t: 'Software around your workflow', d: 'We design to how your business actually operates — not a template you have to bend to.' },
  { t: 'Professional UI/UX', d: 'Clean, modern interfaces your staff and customers find easy to use.' },
  { t: 'Scalable architecture', d: 'Built to grow with you — more branches, more users, more orders.' },
  { t: 'Multi-branch where you need it', d: 'Central visibility with per-branch data isolation, built in.' },
  { t: 'Secure engineering practices', d: 'Signed invoices, device-level access control, and careful data handling.' },
  { t: 'Ongoing development & support', d: 'A technology partner for the long run — maintenance and new features as you grow.' },
];

const industries = [
  'Restaurants', 'Cafés', 'Broasted Chicken', 'Cloud Kitchens',
  'Supermarkets', 'Retail', 'Multi-Branch Food', 'Service Businesses',
];

const process = [
  { n: '01', t: 'Discover', d: 'We learn your business, goals and requirements before writing a line of code.' },
  { n: '02', t: 'Design', d: 'We plan the solution, the user experience and the architecture.' },
  { n: '03', t: 'Develop', d: 'We build, integrate and test the software your business needs.' },
  { n: '04', t: 'Launch & Support', d: 'We deploy, onboard your team, and support you under an agreed plan.' },
];

const faqs = [
  { q: 'What is RestoPOS?', a: 'RestoPOS is a business management and point-of-sale platform — and a software studio. We offer a ready-to-use POS with ZATCA Phase 2 e-invoicing, and we also build custom mobile apps, ordering systems and business software tailored to each client.' },
  { q: 'Do you develop customized mobile applications?', a: 'Yes. We build native iOS and Android apps — customer ordering apps, admin dashboards, and other business apps — designed around your brand and workflow.' },
  { q: 'Can you develop apps for restaurants with multiple branches?', a: 'Yes. Multi-branch is built into the RestoPOS platform — one account, per-branch VAT isolation and consolidated reporting — and we can extend it for larger or custom operations.' },
  { q: 'Does RestoPOS support ZATCA e-invoicing?', a: 'Yes. RestoPOS is ZATCA Phase 2-certified: invoices are cryptographically signed, QR-coded and reported to Fatoora.' },
  { q: 'Can RestoPOS integrate with an existing ordering application?', a: 'Yes — integration with external ordering systems is supported, and we can build custom integrations where needed.' },
  { q: 'Can you build both Android and iOS applications?', a: 'Yes, for both platforms, published under your own brand.' },
  { q: 'How is custom software pricing calculated?', a: 'Custom work is quoted per project, based on scope and requirements. Share your idea on the contact page and we’ll prepare a tailored quotation.' },
  { q: 'Do you provide ongoing maintenance and technical support?', a: 'Yes. We offer maintenance and ongoing development under agreed support plans, plus in-app live chat for the RestoPOS platform.' },
  { q: 'How can I request a demo or quotation?', a: 'Use the Request a Demo button or the contact page — tell us about your business and what you need, and we’ll follow up on WhatsApp or by email.' },
];
---

<Layout
  title="RestoPOS — Business Software & Custom App Development"
  description="RestoPOS builds business management software and custom applications — ZATCA Phase 2 POS and billing, branded restaurant ordering apps, and tailored iOS, Android and web software for businesses in Saudi Arabia and beyond."
>
  <!-- ============================ HERO ============================ -->
  <section class="relative overflow-x-clip px-6 pb-20 pt-36 md:px-8 md:pt-44">
    <div aria-hidden="true" data-parallax="0.18" class="pointer-events-none absolute left-1/4 top-0 -z-10 h-[32rem] w-[40rem] -translate-x-1/2 rounded-full bg-leaf/[0.07] blur-[140px] will-change-transform"></div>
    <div aria-hidden="true" data-parallax="-0.1" class="pointer-events-none absolute right-1/4 top-10 -z-10 h-[32rem] w-[40rem] translate-x-1/2 rounded-full bg-gold/[0.06] blur-[140px] will-change-transform"></div>

    <div class="mx-auto grid max-w-6xl items-center gap-14 lg:grid-cols-[1.05fr_1fr]">
      <div>
        <p class="mb-6 text-[12px] uppercase tracking-[0.2em] text-gold">Business software &amp; custom development</p>
        <h1 class="text-balance text-display-xl font-extrabold leading-[0.98] text-bone">
          Powerful software.<br /><span class="text-gold">Built around your business.</span>
        </h1>
        <p class="mt-7 max-w-lg text-balance text-lg leading-relaxed text-bone/60">
          From smart billing and restaurant management to fully customized mobile apps and digital
          platforms, RestoPOS builds technology designed around how your business actually works.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a href="#divisions" class="brand-gradient ease-out-quad whitespace-nowrap rounded-full px-8 py-3.5 text-sm font-semibold text-white shadow-[0_8px_28px_rgba(76,122,82,0.35)] transition duration-300 hover:brightness-110">
            Explore Our Solutions
          </a>
          <a href="/contact" class="ease-out-quad whitespace-nowrap rounded-full border border-bone/20 px-7 py-3.5 text-sm font-medium text-bone transition-colors duration-300 hover:border-bone/50">
            Discuss Your Project
          </a>
        </div>
        <div class="mt-9 flex flex-wrap gap-x-7 gap-y-2 text-xs text-bone/40">
          <span>✓ ZATCA Phase 2-certified</span>
          <span>✓ Bilingual Arabic &amp; English</span>
          <span>✓ iOS · Android · Web</span>
        </div>
      </div>

      <!-- Right: coded product mocks (POS console + branded app), floating -->
      <div class="relative pb-10 pl-10 [perspective:1600px] sm:pb-0">
        <div class="animate-float">
          <div data-tilt class="light-sweep relative overflow-hidden rounded-2xl border border-hairline bg-charcoal-soft/80 p-2 shadow-gold backdrop-blur-xl">
            <DashboardPreview />
          </div>
        </div>
        <!-- Phone: an illustrative branded ordering app -->
        <div class="absolute -bottom-2 left-0 w-36 rotate-[-6deg] sm:w-44 lg:-left-6">
          <div class="light-sweep shadow-gold">
            <AppMock />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== TWO DIVISIONS ===================== -->
  <section id="divisions" class="mx-auto max-w-6xl scroll-mt-24 px-6 pt-28 md:px-8">
    <div data-reveal>
      <p class="mb-5 text-[12px] uppercase tracking-[0.2em] text-gold">What we do</p>
      <h2 class="max-w-2xl text-balance text-display-lg font-bold text-bone">
        Technology solutions for every stage of your business.
      </h2>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-2">
      <!-- Card A -->
      <div data-reveal class="ease-out-quad flex flex-col overflow-hidden rounded-3xl border border-hairline bg-charcoal-soft/40 transition-colors duration-500 hover:border-gold/30">
        <div class="border-b border-hairline bg-charcoal p-4">
          <DashboardPreview />
        </div>
        <div class="flex flex-1 flex-col p-8">
          <span class="text-[11px] uppercase tracking-widest text-gold">RestoPOS Platform</span>
          <h3 class="mt-3 text-xl font-semibold text-bone">Smart business management with RestoPOS</h3>
          <p class="mt-3 text-sm leading-relaxed text-bone/55">
            Simplify billing, manage operations, generate compliant invoices, and get clear
            visibility into your business through one integrated platform.
          </p>
          <ul class="mt-5 flex flex-wrap gap-2 text-xs text-bone/60">
            {['POS & billing', 'ZATCA e-invoicing', 'Reporting', 'Multi-branch'].map((x) => (
              <li class="rounded-md border border-hairline px-2.5 py-1">{x}</li>
            ))}
          </ul>
          <a href="/features" class="ease-out-quad mt-7 inline-flex w-fit items-center gap-2 text-sm font-semibold text-gold transition-transform duration-300 hover:gap-3">
            Explore Platform →
          </a>
        </div>
      </div>

      <!-- Card B -->
      <div data-reveal style="--reveal-delay: 0.1s" class="ease-out-quad flex flex-col overflow-hidden rounded-3xl border border-hairline bg-charcoal-soft/40 transition-colors duration-500 hover:border-gold/30">
        <div class="flex items-center justify-center border-b border-hairline bg-charcoal p-6">
          <div class="w-48"><AppMock /></div>
        </div>
        <div class="flex flex-1 flex-col p-8">
          <span class="text-[11px] uppercase tracking-widest text-gold">Custom Software Development</span>
          <h3 class="mt-3 text-xl font-semibold text-bone">Custom software built for your business</h3>
          <p class="mt-3 text-sm leading-relaxed text-bone/55">
            From branded mobile apps to complex management platforms, we develop tailored software
            designed to fit your exact operational requirements.
          </p>
          <ul class="mt-5 flex flex-wrap gap-2 text-xs text-bone/60">
            {['iOS & Android', 'Web apps', 'Dashboards', 'Integrations'].map((x) => (
              <li class="rounded-md border border-hairline px-2.5 py-1">{x}</li>
            ))}
          </ul>
          <a href="/custom-development" class="ease-out-quad mt-7 inline-flex w-fit items-center gap-2 text-sm font-semibold text-gold transition-transform duration-300 hover:gap-3">
            Explore Development Services →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== WHAT WE BUILD ===================== -->
  <section class="mx-auto max-w-6xl px-6 pt-28 md:px-8">
    <h2 class="max-w-xl text-balance text-display-md font-bold text-bone" data-reveal>
      Everything your business needs, powered by technology.
    </h2>
    <div class="mt-14 grid gap-px overflow-hidden rounded-2xl bg-hairline sm:grid-cols-2 lg:grid-cols-4">
      {
        build.map((b, i) => (
          <a href={b.href} data-reveal style={`--reveal-delay: ${(i % 4) * 0.06}s`} class="ease-out-quad group bg-charcoal p-7 transition-colors duration-500 hover:bg-charcoal-soft">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg border border-gold/30 text-gold" aria-hidden="true">
              <span class="h-2 w-2 rounded-sm bg-gold"></span>
            </div>
            <h3 class="mt-5 text-sm font-semibold text-bone">{b.t}</h3>
            <p class="mt-2 text-xs leading-relaxed text-bone/50">{b.d}</p>
            <span class="ease-out-quad mt-4 inline-block text-xs font-medium text-gold/80 transition-colors group-hover:text-gold">Learn more →</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ===================== WHY CHOOSE ===================== -->
  <section class="mx-auto max-w-6xl px-6 pt-28 md:px-8">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div data-reveal>
        <p class="mb-5 text-[12px] uppercase tracking-[0.2em] text-gold">Why RestoPOS</p>
        <h2 class="text-balance text-display-md font-bold text-bone">More than software. A technology partner for your business.</h2>
        <p class="mt-6 max-w-sm leading-relaxed text-bone/55">
          We build maintainable technology around real workflows — and stay with you as your
          business grows.
        </p>
      </div>
      <div class="grid gap-px overflow-hidden rounded-2xl bg-hairline sm:grid-cols-2">
        {
          why.map((w, i) => (
            <div data-reveal style={`--reveal-delay: ${(i % 2) * 0.08}s`} class="bg-charcoal p-6">
              <h3 class="text-sm font-semibold text-bone">{w.t}</h3>
              <p class="mt-2 text-xs leading-relaxed text-bone/50">{w.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== INDUSTRIES ===================== -->
  <section class="mx-auto max-w-6xl px-6 pt-28 md:px-8">
    <h2 class="text-balance text-display-md font-bold text-bone" data-reveal>Industries we serve.</h2>
    <div class="mt-10 flex flex-wrap gap-3" data-reveal>
      {
        industries.map((name) => (
          <a href="/features" class="ease-out-quad rounded-full border border-hairline bg-charcoal-soft/40 px-5 py-2.5 text-sm text-bone/70 transition-colors duration-300 hover:border-gold/40 hover:text-bone">
            {name}
          </a>
        ))
      }
    </div>
  </section>

  <!-- ===================== HOW WE WORK ===================== -->
  <section class="mx-auto max-w-6xl px-6 pt-28 md:px-8">
    <div data-reveal>
      <p class="mb-5 text-[12px] uppercase tracking-[0.2em] text-gold">How we work</p>
      <h2 class="max-w-xl text-balance text-display-md font-bold text-bone">From your idea to a working solution.</h2>
    </div>
    <div class="relative mt-14 grid gap-10 md:grid-cols-4 md:gap-6">
      <div aria-hidden="true" class="absolute left-[15px] top-4 bottom-4 hidden w-px bg-gradient-to-b from-leaf/50 via-gold/30 to-transparent md:left-0 md:right-0 md:top-[15px] md:bottom-auto md:h-px md:w-full md:bg-gradient-to-r"></div>
      {
        process.map((s, i) => (
          <div data-reveal style={`--reveal-delay: ${i * 0.1}s`} class="relative">
            <span class="flex h-8 w-8 items-center justify-center rounded-full border border-gold/30 bg-charcoal font-mono text-sm text-gold">{s.n}</span>
            <h3 class="mt-6 text-lg font-semibold text-bone">{s.t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-bone/55">{s.d}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="mx-auto max-w-3xl px-6 pt-28 md:px-8">
    <div data-reveal>
      <p class="mb-5 text-[12px] uppercase tracking-[0.2em] text-gold">FAQ</p>
      <h2 class="text-balance text-display-md font-bold text-bone">Questions, answered.</h2>
    </div>
    <div class="mt-12 divide-y divide-hairline border-y border-hairline">
      {
        faqs.map((f, i) => (
          <details data-reveal style={`--reveal-delay: ${(i % 4) * 0.06}s`} class="group">
            <summary class="ease-out-quad flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-left font-medium text-bone transition-colors duration-300 hover:text-gold [&::-webkit-details-marker]:hidden">
              {f.q}
              <span aria-hidden="true" class="ease-out-quad shrink-0 text-gold transition-transform duration-300 group-open:rotate-45">＋</span>
            </summary>
            <p class="pb-5 text-sm leading-relaxed text-bone/55">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- ===================== MAIN CTA ===================== -->
  <section class="mx-auto mt-28 max-w-6xl px-6 md:px-8">
    <div data-reveal class="light-sweep relative overflow-hidden rounded-3xl border border-gold/20 bg-gradient-to-b from-charcoal-soft to-charcoal px-8 py-16 text-center md:px-16">
      <h2 class="mx-auto max-w-xl text-balance text-display-md font-bold text-bone">
        Have a business idea? Let’s build the technology behind it.
      </h2>
      <p class="mx-auto mt-5 max-w-lg text-balance leading-relaxed text-bone/55">
        Whether you need a ready-to-use platform or fully customized software, we’re ready to
        understand your requirements.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href="/contact" class="brand-gradient ease-out-quad inline-block rounded-full px-8 py-3.5 text-sm font-semibold text-white shadow-[0_8px_28px_rgba(76,122,82,0.35)] transition duration-300 hover:brightness-110">
          Request a Consultation
        </a>
        <a href="/contact" class="ease-out-quad inline-block rounded-full border border-bone/20 px-7 py-3.5 text-sm font-medium text-bone transition-colors duration-300 hover:border-bone/50">
          Contact Our Team
        </a>
      </div>
    </div>
  </section>

  <div class="mt-8"></div>
</Layout>
