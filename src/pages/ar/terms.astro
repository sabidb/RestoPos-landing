---
// Arabic Terms (RTL). Drafted Arabic — NEEDS NATIVE/LEGAL REVIEW.
import Layout from '../../layouts/Layout.astro';

const updated = 'أكتوبر 2025';

const sections = [
  { h: 'عن هذه الشروط', b: 'تنطبق هذه الشروط على استخدامك لهذا الموقع، الذي تديره RestoPOS (المقر الرئيسي: إيريتي، كانور، كيرالا، الهند). باستخدامك هذا الموقع فإنك توافق على هذه الشروط.' },
  { h: 'استخدام الموقع', b: 'يمكنك استخدام هذا الموقع للتعرّف على منتجاتنا وخدماتنا والتواصل معنا. وتوافق على عدم إساءة استخدامه أو محاولة تعطيله أو استخدامه لأي غرض غير قانوني.' },
  { h: 'المنتجات والخدمات', b: 'تصف المعلومات على هذا الموقع منصة RestoPOS وخدمات التطوير المخصصة لدينا. وتُحدّد الميزات والنطاق والجداول الزمنية والأسعار لأي ارتباط في اتفاقية أو عرض سعر منفصل.' },
  { h: 'الاستفسارات وعروض الأسعار', b: 'إرسال استفسار أو طلب عرض تجريبي لا ينشئ عقداً. وأي عمل نقوم به يخضع لاتفاقية مكتوبة منفصلة.' },
  { h: 'الملكية الفكرية', b: 'اسم RestoPOS وشعارها ومحتوى الموقع وتصميمه مملوكة لنا أو لمرخّصينا، ولا يجوز نسخها أو إعادة استخدامها دون إذن.' },
  { h: 'خدمات الأطراف الثالثة', b: 'تعتمد خيارات التواصل لدينا على خدمات أطراف ثالثة مثل واتساب ومزوّدي البريد الإلكتروني، التي تعمل وفق شروطها الخاصة.' },
  { h: 'حدود المسؤولية', b: 'يُقدَّم هذا الموقع «كما هو». وبالقدر الذي يسمح به القانون، لسنا مسؤولين عن أي خسارة ناشئة عن استخدامك للموقع نفسه.' },
  { h: 'التغييرات', b: 'قد نحدّث هذه الشروط من وقت لآخر. ستتوفر دائماً أحدث نسخة على هذه الصفحة.' },
  { h: 'التواصل', b: 'يمكن إرسال الأسئلة حول هذه الشروط عبر صفحة التواصل.' },
];
---

<Layout lang="ar" title="شروط الخدمة — RestoPOS" description="الشروط التي تنطبق على استخدام موقع RestoPOS.">
  <div class="pb-8 pt-40">
    <section class="mx-auto max-w-3xl px-6 md:px-8">
      <p class="mb-5 text-[12px] uppercase tracking-[0.2em] text-gold">قانوني</p>
      <h1 class="text-balance text-display-lg font-extrabold text-bone">شروط الخدمة</h1>
      <p class="mt-4 text-sm text-bone/40">آخر تحديث: {updated}</p>
      <div class="mt-12 space-y-10">
        {
          sections.map((s) => (
            <div>
              <h2 class="text-lg font-semibold text-bone">{s.h}</h2>
              <p class="mt-3 text-[15px] leading-relaxed text-bone/60">{s.b}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-14 rounded-xl border border-hairline bg-charcoal-soft/40 p-5 text-xs leading-relaxed text-bone/40">
        هذه شروط عامة مقدّمة للشفافية. للحصول على شروط ملزمة قانونياً، يُرجى مراجعتها مع مختص مؤهل في نطاقك القضائي.
      </p>
    </section>
  </div>
</Layout>
