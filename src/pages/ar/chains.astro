---
// Arabic Chains / multi-branch (RTL). Drafted Arabic — NEEDS NATIVE REVIEW.
import Layout from '../../layouts/Layout.astro';
import DemoCta from '../../components/DemoCta.astro';

const capabilities = [
  { title: 'حساب واحد، كل الفروع', body: 'شغّل كل منافذك ضمن مستأجر واحد. يحتفظ كل فرع برقمه الضريبي وبياناته المعزولة بالكامل، بينما تراها جميعاً معاً — دون تسجيلات دخول منفصلة.' },
  { title: 'تقارير موحّدة', body: 'تتجمع المبيعات والضريبة وعدد الفواتير عبر كل فرع في رؤية واحدة، أو تعمّق في منفذ واحد. قارن الفروع جنباً إلى جنب دون أي تصدير.' },
  { title: 'إقفال يوم لكل فرع', body: 'يقفل كل فرع ورديّته ويسوّيها حتى الريال مقابل فاتورة. يرى المقر الرئيسي كل إقفالات اليوم في خط زمني واحد، مطابقة ومدقّقة للفروقات.' },
  { title: 'تحكم بالأجهزة لكل منفذ', body: 'نموذج المنع الافتراضي: كل كاشير في كل فرع يسجّل دخوله منفرداً، ولا يفوتر أي جهاز جديد ريالاً واحداً حتى يوافق عليه المالك — موافقات تديرها مركزياً.' },
  { title: 'اشتراك واحد، منافذ متعددة', body: 'أضف فرعاً دون عقد جديد أو تثبيت جديد. تبقى الفوترة على اشتراك واحد، ليصبح النمو إعداداً لا دورة شراء.' },
  { title: 'نفس الامتثال، في كل مكان', body: 'يبلّغ كل فرع فاتورة عبر نفس خط ZATCA المرحلة الثانية المعتمد. افتح منفذاً في مدينة جديدة ويكون الامتثال متطابقاً من اليوم الأول.' },
];

const service = [
  { n: '٠١', title: 'نرسم خريطة فروعك', body: 'مكالمة لفهم طريقة عمل منافذك فعلياً — الأرقام الضريبية، القوائم، الطابعات، الأدوار — ليُهيّأ الحساب وفق عمليتك، لا وفق قالب.' },
  { n: '٠٢', title: 'نهيّئ كل فرع على فاتورة', body: 'تعمل تهيئة ZATCA الآلية ذات الخطوات السبع لكل منفذ — من تسجيل الجهاز حتى الإبلاغ الإنتاجي. تزوّدنا برمز تحقق واحد من البوابة لكل فرع، ونتولّى الباقي.' },
  { n: '٠٣', title: 'ندرّب فرقك', body: 'يحصل موظفو الكاشير ومديرو الفروع والمقر الرئيسي على شرح للأجزاء التي يستخدمونها — بالعربية أو الإنجليزية — ليكون الإطلاق ورديّة عادية لا فوضى.' },
  { n: '٠٤', title: 'نبقى على تواصل', body: 'دردشة مباشرة داخل لوحة الإدارة، وجهة اتصال مخصصة تتولى الأسئلة التي تظهر فقط بعد أن تعمل عبر المواقع.' },
];
---

<Layout
  lang="ar"
  title="للسلاسل والفروع المتعددة — RestoPOS"
  description="أدِر كل فروع مطعمك أو تجارتك على حساب RestoPOS واحد متوافق مع ZATCA — تقارير موحّدة، وعزل ضريبي لكل فرع، وتحكم مركزي بالأجهزة، وتهيئة عملية لكل منفذ."
>
  <div class="pb-8 pt-40">
    <section class="mx-auto max-w-6xl px-6 md:px-8">
      <div data-reveal>
        <p class="mb-5 text-[12px] uppercase tracking-[0.2em] text-gold">للسلاسل والفروع المتعددة</p>
        <h1 class="max-w-3xl text-balance text-display-lg font-extrabold text-bone">أدِر السلسلة كاملة من شاشة واحدة.</h1>
        <p class="mt-6 max-w-xl leading-relaxed text-bone/55">
          فرعان أو عشرون، تشغّلها RestoPOS على حساب واحد — كل منفذ برقمه الضريبي وبياناته المعزولة،
          وكلها تتجمع في رؤية واحدة متوافقة. ونجهّز كل فرع لك، منفذاً تلو الآخر، ليصبح التوسّع قراراً لا مشروعاً.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a href="/ar/contact" class="brand-gradient ease-out-quad whitespace-nowrap rounded-full px-8 py-3.5 text-sm font-semibold text-white shadow-[0_8px_28px_rgba(76,122,82,0.35)] transition duration-300 hover:brightness-110">تحدث إلى فريقنا</a>
          <a href="/ar/features" class="ease-out-quad whitespace-nowrap px-2 py-3.5 text-sm font-medium text-bone/60 transition-colors duration-300 hover:text-bone">شاهد كل الميزات ←</a>
        </div>
      </div>
    </section>

    <section class="mx-auto mt-20 max-w-5xl px-6 md:px-8">
      <div data-reveal class="light-sweep relative overflow-hidden rounded-2xl border border-hairline bg-charcoal-soft/60 p-5 shadow-gold backdrop-blur-xl md:p-7">
        <div class="flex items-center justify-between font-mono text-[11px] text-bone/40">
          <span>اليوم · كل الفروع</span>
          <span class="text-leaf-bright">● مباشر</span>
        </div>
        <div class="mt-3 flex items-baseline gap-4">
          <span class="text-display-md font-semibold text-bone">SAR 148,920</span>
          <span class="font-mono text-sm text-leaf-bright">+9.2%</span>
        </div>
        <div class="mt-6 grid gap-px overflow-hidden rounded-xl bg-hairline sm:grid-cols-2 lg:grid-cols-4">
          {
            [
              { b: 'العليا', v: 'SAR 52,180', s: '342 فاتورة' },
              { b: 'الملقا', v: 'SAR 41,090', s: '268 فاتورة' },
              { b: 'الخبر', v: 'SAR 33,470', s: '211 فاتورة' },
              { b: 'جدة · التحلية', v: 'SAR 22,180', s: '154 فاتورة' },
            ].map((x) => (
              <div class="bg-charcoal p-4 font-mono text-[11px]">
                <div class="flex items-center justify-between text-bone/40">
                  <span>{x.b}</span>
                  <span class="text-leaf-bright">●</span>
                </div>
                <p class="mt-2 text-base text-bone">{x.v}</p>
                <div class="mt-1 flex items-center justify-between text-bone/50">
                  <span>{x.s}</span>
                  <span class="text-leaf-bright">فاتورة ✓</span>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="mx-auto mt-32 max-w-6xl px-6 md:px-8">
      <h2 class="max-w-xl text-balance text-display-md font-bold text-bone" data-reveal>مبنية لأكثر من موقع واحد.</h2>
      <p class="mt-5 max-w-lg leading-relaxed text-bone/55" data-reveal>
        تعدد الفروع ليس إضافة — إنها طريقة بناء المنتج. يبقى كل منفذ مستقلاً حيث يتطلب القانون، ومترابطاً حيث تحتاج.
      </p>
      <div class="mt-14 grid gap-px overflow-hidden rounded-2xl bg-hairline sm:grid-cols-2 lg:grid-cols-3">
        {
          capabilities.map((c, i) => (
            <div data-reveal style={`--reveal-delay: ${(i % 3) * 0.08}s`} class="h-full">
              <div class="ease-out-quad h-full bg-charcoal p-8 transition-colors duration-500 hover:bg-charcoal-soft">
                <h3 class="font-semibold text-bone">{c.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-bone/50">{c.body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="relative mx-auto mt-32 max-w-6xl px-6 md:px-8">
      <div data-reveal>
        <p class="mb-5 text-[12px] uppercase tracking-[0.2em] text-gold">خدمة متكاملة</p>
        <h2 class="max-w-xl text-balance text-display-md font-bold text-bone">لا نسلّمك مجرد تسجيل دخول.</h2>
        <p class="mt-5 max-w-lg leading-relaxed text-bone/55">
          التوسّع متعدد المواقع له تفاصيل كثيرة — رقم ضريبي لكل فرع، وطابعات، وموظفون، وتهيئة فاتورة لكل منفذ.
          نقوم بهذا العمل معك، ليفتح كل فرع جاهزاً للفوترة.
        </p>
      </div>

      <div class="relative mt-14 grid gap-10 md:grid-cols-2 md:gap-x-16 md:gap-y-14">
        {
          service.map((s, i) => (
            <div data-reveal style={`--reveal-delay: ${(i % 2) * 0.1}s`}>
              <div class="flex gap-5">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-gold/30 bg-charcoal font-mono text-sm text-gold">{s.n}</span>
                <div>
                  <h3 class="text-lg font-semibold text-bone">{s.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-bone/55">{s.body}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mx-auto mt-32 max-w-3xl px-6 text-center md:px-8">
      <p class="text-balance text-xl leading-relaxed text-bone/70" data-reveal>
        يعمل كل فرع على نفس النواة المعتمدة لـ ZATCA المرحلة الثانية — فسواء كان لديك منفذ واحد أو عشرة عبر
        المملكة، يكون الامتثال متطابقاً ويرى مقرك الرئيسي كل ذلك دفعة واحدة.
      </p>
    </section>

    <div class="mt-32">
      <DemoCta heading="لنجهّز سلسلتك على RestoPOS." ctaLabel="تحدث إلينا" ctaHref="/ar/contact" />
    </div>
  </div>
</Layout>
