---
// Arabic Privacy (RTL). Drafted Arabic — NEEDS NATIVE/LEGAL REVIEW.
import Layout from '../../layouts/Layout.astro';

const updated = 'أكتوبر 2025';

const sections = [
  { h: 'من نحن', b: 'يُدار هذا الموقع من قبل RestoPOS، شركة برمجيات أعمال وتطوير مخصص، ومقرها الرئيسي في إيريتي، كانور، كيرالا، الهند. توضّح هذه السياسة كيفية تعاملنا مع المعلومات التي تُجمع عبر هذا الموقع.' },
  { h: 'المعلومات التي نجمعها', b: 'نجمع التفاصيل التي تختار إرسالها إلينا عبر نماذج التواصل وطلب العرض التجريبي — مثل اسمك واسم عملك ورقم هاتفك أو واتساب وبريدك الإلكتروني ورسالتك. لا نطلب بيانات بطاقات الدفع على هذا الموقع.' },
  { h: 'كيف نستخدمها', b: 'نستخدم المعلومات التي ترسلها فقط للرد على استفسارك، وإعداد عرض تجريبي أو عرض سعر، والمتابعة بشأن طلبك. لا نبيع معلوماتك.' },
  { h: 'كيف تُرسل الاستفسارات', b: 'يفتح نموذج التواصل لدينا واتساب أو تطبيق البريد الإلكتروني وبياناتك معبّأة مسبقاً، لتصل رسالتك إلينا مباشرة عبر تلك الخدمات، التي تعالج رسالتك وفق سياسات الخصوصية الخاصة بها.' },
  { h: 'الاحتفاظ بالبيانات', b: 'نحتفظ بتفاصيل الاستفسار فقط للمدة اللازمة للرد عليه ومتابعته، ما لم تطلب حذفها قبل ذلك.' },
  { h: 'خياراتك', b: 'يمكنك سؤالنا عن المعلومات التي نحتفظ بها عنك، أو طلب تصحيحها أو حذفها، عبر بيانات التواصل في صفحة التواصل.' },
  { h: 'تغييرات على هذه السياسة', b: 'قد نحدّث هذه السياسة من وقت لآخر. ستتوفر دائماً أحدث نسخة على هذه الصفحة.' },
  { h: 'التواصل', b: 'لأي سؤال حول هذه السياسة أو معلوماتك، تواصل معنا عبر صفحة التواصل.' },
];
---

<Layout lang="ar" title="سياسة الخصوصية — RestoPOS" description="كيف تتعامل RestoPOS مع المعلومات المُجمّعة عبر هذا الموقع.">
  <div class="pb-8 pt-40">
    <section class="mx-auto max-w-3xl px-6 md:px-8">
      <p class="mb-5 text-[12px] uppercase tracking-[0.2em] text-gold">قانوني</p>
      <h1 class="text-balance text-display-lg font-extrabold text-bone">سياسة الخصوصية</h1>
      <p class="mt-4 text-sm text-bone/40">آخر تحديث: {updated}</p>
      <div class="mt-12 space-y-10">
        {
          sections.map((s) => (
            <div>
              <h2 class="text-lg font-semibold text-bone">{s.h}</h2>
              <p class="mt-3 text-[15px] leading-relaxed text-bone/60">{s.b}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-14 rounded-xl border border-hairline bg-charcoal-soft/40 p-5 text-xs leading-relaxed text-bone/40">
        هذه سياسة عامة مقدّمة للشفافية. للحصول على سياسة ملزمة قانونياً، يُرجى مراجعتها مع مختص مؤهل في نطاقك القضائي.
      </p>
    </section>
  </div>
</Layout>
