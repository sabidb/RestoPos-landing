---
// Arabic App Development (RTL). Drafted Arabic — NEEDS NATIVE REVIEW.
import Layout from '../../layouts/Layout.astro';
import DemoCta from '../../components/DemoCta.astro';
import AppMock from '../../components/AppMock.astro';

const services = [
  { t: 'تطبيقات Android مخصصة', d: 'تطبيقات Android أصلية مبنية حول علامتك التجارية وسير عملك.', i: '<path d="M6 10a6 6 0 0 1 12 0v6a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1z"/><path d="M7 10 5.5 7.5M17 10l1.5-2.5M9.5 7h.01M14.5 7h.01"/>' },
  { t: 'تطبيقات iOS مخصصة', d: 'تطبيقات أصلية لـ iPhone و iPad، منشورة باسمك الخاص.', i: '<rect x="6" y="2" width="12" height="20" rx="2"/><path d="M10 19h4"/>' },
  { t: 'تطبيقات طلب المطاعم', d: 'طلب بعلامتك التجارية للتوصيل والاستلام وتناول الطعام في المكان لعملائك.', i: '<path d="M6 8h12l-1 12H7L6 8Z"/><path d="M9 8a3 3 0 0 1 6 0"/>' },
  { t: 'أنظمة التوصيل والاستلام', d: 'التقاط الطلبات وتدفقات التنفيذ مرتبطة بعملياتك.', i: '<path d="M3 6h11v9H3zM14 9h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/>' },
  { t: 'تطبيقات العملاء', d: 'تطبيقات ولاء وإعادة طلب وتفاعل لعملائك الدائمين.', i: '<rect x="6" y="2" width="12" height="20" rx="2"/><circle cx="12" cy="9" r="2"/><path d="M8.5 15.5a3.5 3.5 0 0 1 7 0"/>' },
  { t: 'لوحات تحكم الإدارة', d: 'لوحات تحكم وتقارير مبنية لطريقة إدارتك الفعلية.', i: '<rect x="4" y="4" width="7" height="7" rx="1"/><rect x="13" y="4" width="7" height="4" rx="1"/><rect x="13" y="10" width="7" height="10" rx="1"/><rect x="4" y="13" width="7" height="7" rx="1"/>' },
  { t: 'أنظمة عرض المطبخ', d: 'تدفقات مطبخ على الشاشة تحل محل التذاكر الورقية.', i: '<rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M8 20h8M12 16v4"/>' },
  { t: 'تطبيقات السائقين', d: 'تطبيقات توزيع وتوصيل لأسطولك الخاص.', i: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.5"/><path d="M12 3v6.5M4.5 17l5-3.5M19.5 17l-5-3.5"/>' },
  { t: 'أنظمة متعددة الفروع', d: 'إدارة مركزية مع بيانات وضوابط لكل فرع.', i: '<circle cx="6" cy="6" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><path d="M6 8v1a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V8M12 13v3"/>' },
  { t: 'مواقع وتطبيقات ويب للأعمال', d: 'مواقع تسويقية وتطبيقات ويب كاملة سريعة وحديثة.', i: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/>' },
  { t: 'الأنظمة الخلفية والتكامل', d: 'واجهات برمجية وخطوط بيانات وربط بالأدوات التي تستخدمها.', i: '<path d="M9.5 14.5l5-5"/><path d="M10 7l1-1a4 4 0 0 1 6 6l-1 1"/><path d="M14 17l-1 1a4 4 0 0 1-6-6l1-1"/>' },
  { t: 'أتمتة سير العمل', d: 'أنظمة سحابية تزيل العمل اليدوي المتكرر.', i: '<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>' },
];

const process = [
  { n: '٠١', t: 'الاكتشاف', d: 'نفهم أعمالك وأهدافك ومتطلباتك.' },
  { n: '٠٢', t: 'التصميم', d: 'نخطط للتجربة والبنية والنطاق.' },
  { n: '٠٣', t: 'التطوير', d: 'نبني وندمج ونختبر البرمجيات.' },
  { n: '٠٤', t: 'الإطلاق والدعم', d: 'ننشر، وندرّب فريقك، وندعمك.' },
];
---

<Layout
  lang="ar"
  title="تطوير التطبيقات — RestoPOS"
  description="تبني RestoPOS برمجيات مخصصة — تطبيقات iOS و Android أصلية، وأنظمة طلب وتوصيل للمطاعم، ولوحات تحكم، ومواقع، وواجهات برمجية وأتمتة — مصممة حول علامتك التجارية وسير عملك."
>
  <div class="pb-8 pt-40">
    <section class="mx-auto max-w-6xl px-6 md:px-8">
      <div class="grid items-center gap-14 lg:grid-cols-[1.1fr_0.9fr]">
        <div data-reveal>
          <p class="mb-5 text-[12px] uppercase tracking-[0.2em] text-gold">تطوير التطبيقات والبرمجيات</p>
          <h1 class="max-w-2xl text-balance text-display-lg font-extrabold text-bone">تطبيقك، مبني حول أعمالك — لا مستعار من أعمال غيرك.</h1>
          <p class="mt-6 max-w-xl leading-relaxed text-bone/55">
            إلى جانب منصة RestoPOS، نصمم ونبني تطبيقات مخصصة مصممة حول علامتك التجارية وسير عملك ومتطلباتك
            التجارية — تطبيقات جوال، وأنظمة طلب، ولوحات تحكم، ومواقع، والأنظمة الخلفية التي تشغّلها.
          </p>
          <div class="mt-9 flex flex-wrap items-center gap-4">
            <a href="/ar/contact" class="brand-gradient ease-out-quad rounded-full px-8 py-3.5 text-sm font-semibold text-white shadow-[0_8px_28px_rgba(76,122,82,0.35)] transition duration-300 hover:brightness-110">ناقش مشروعك</a>
            <a href="/ar/ordering" class="ease-out-quad rounded-full border border-bone/20 px-7 py-3.5 text-sm font-medium text-bone transition-colors duration-300 hover:border-bone/50">شاهد تطبيق الطلب</a>
          </div>
          <div class="mt-9 flex flex-wrap gap-x-7 gap-y-2 text-xs text-bone/40">
            <span>✓ iOS و Android</span>
            <span>✓ منشورة باسم علامتك</span>
            <span>✓ مبنية على نواة RestoPOS</span>
          </div>
        </div>

        <div class="mx-auto w-full max-w-[18rem] [perspective:1400px]" data-reveal style="--reveal-delay: 0.1s">
          <div data-tilt class="light-sweep animate-float shadow-gold"><AppMock /></div>
        </div>
      </div>
    </section>

    <section class="mx-auto mt-24 max-w-6xl px-6 md:px-8">
      <h2 class="max-w-lg text-balance text-display-md font-bold text-bone" data-reveal>ماذا نطوّر.</h2>
      <div class="mt-12 grid gap-px overflow-hidden rounded-2xl bg-hairline sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((s, i) => (
            <div data-reveal style={`--reveal-delay: ${(i % 3) * 0.07}s`} class="ease-out-quad group bg-charcoal p-7 transition-colors duration-500 hover:bg-charcoal-soft">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-gold/30 bg-gold/5 text-gold transition-colors duration-500 group-hover:bg-gold/10" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={s.i}></svg>
              </div>
              <h3 class="mt-5 text-sm font-semibold text-bone">{s.t}</h3>
              <p class="mt-2 text-xs leading-relaxed text-bone/50">{s.d}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mx-auto mt-28 max-w-6xl px-6 md:px-8">
      <div data-reveal>
        <p class="mb-5 text-[12px] uppercase tracking-[0.2em] text-gold">كيف نعمل</p>
        <h2 class="max-w-xl text-balance text-display-md font-bold text-bone">من فكرتك إلى حل يعمل.</h2>
      </div>
      <div class="relative mt-14 grid gap-10 md:grid-cols-4 md:gap-6">
        <div aria-hidden="true" class="absolute top-4 bottom-4 hidden w-px bg-gradient-to-b from-leaf/50 via-gold/30 to-transparent md:bottom-auto md:top-[15px] md:h-px md:w-full md:bg-gradient-to-l rtl:right-[15px] md:rtl:right-0 md:rtl:left-0"></div>
        {
          process.map((s, i) => (
            <div data-reveal style={`--reveal-delay: ${i * 0.1}s`} class="relative">
              <span class="flex h-8 w-8 items-center justify-center rounded-full border border-gold/30 bg-charcoal font-mono text-sm text-gold">{s.n}</span>
              <h3 class="mt-6 text-lg font-semibold text-bone">{s.t}</h3>
              <p class="mt-2 text-sm leading-relaxed text-bone/55">{s.d}</p>
            </div>
          ))
        }
      </div>
    </section>

    <div class="mt-28">
      <DemoCta heading="لديك فكرة لتطبيق أو برنامج؟ لنحدد نطاقها معاً." ctaLabel="ناقش مشروعك" ctaHref="/ar/contact" />
    </div>
  </div>
</Layout>
