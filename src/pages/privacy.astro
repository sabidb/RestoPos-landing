---
import Layout from '../layouts/Layout.astro';

const updated = 'October 2025';

const sections = [
  { h: 'Who we are', b: 'This website is operated by RestoPOS, a business software and custom development company with its head office in Iritty, Kannur, Kerala, India. This policy explains how we handle information collected through this website.' },
  { h: 'Information we collect', b: 'We collect the details you choose to send us through our contact and demo-request forms — such as your name, business name, phone or WhatsApp number, email, and the message you provide. We do not ask for payment card details on this website.' },
  { h: 'How we use it', b: 'We use the information you submit only to respond to your enquiry, prepare a demo or quotation, and follow up about your request. We do not sell your information.' },
  { h: 'How enquiries are sent', b: 'Our contact form opens WhatsApp or your email application with your details pre-filled, so your message is sent directly to us through those services. Those services handle your message under their own privacy policies.' },
  { h: 'Data retention', b: 'We keep enquiry details only as long as needed to respond to and follow up on your request, unless you ask us to delete them sooner.' },
  { h: 'Your choices', b: 'You can ask us what information we hold about you, or ask us to correct or delete it, by contacting us through the details on our contact page.' },
  { h: 'Changes to this policy', b: 'We may update this policy from time to time. The latest version will always be available on this page.' },
  { h: 'Contact', b: 'For any question about this policy or your information, reach us through our contact page.' },
];
---

<Layout title="Privacy Policy — RestoPOS" description="How RestoPOS handles information collected through this website.">
  <div class="pb-8 pt-40">
    <section class="mx-auto max-w-3xl px-6 md:px-8">
      <p class="mb-5 text-[12px] uppercase tracking-[0.2em] text-gold">Legal</p>
      <h1 class="text-balance text-display-lg font-extrabold text-bone">Privacy Policy</h1>
      <p class="mt-4 text-sm text-bone/40">Last updated: {updated}</p>
      <div class="mt-12 space-y-10">
        {
          sections.map((s) => (
            <div>
              <h2 class="text-lg font-semibold text-bone">{s.h}</h2>
              <p class="mt-3 text-[15px] leading-relaxed text-bone/60">{s.b}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-14 rounded-xl border border-hairline bg-charcoal-soft/40 p-5 text-xs leading-relaxed text-bone/40">
        This is a general policy provided for transparency. For a legally binding policy, have it
        reviewed by a qualified professional for your jurisdiction.
      </p>
    </section>
  </div>
</Layout>
