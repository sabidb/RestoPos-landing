---
import Layout from '../layouts/Layout.astro';
import DemoCta from '../components/DemoCta.astro';

// Real projects. Keep descriptions factual — platforms/category only, no
// invented client names, stats or deployment numbers.
const projects = [
  {
    name: 'RestoPOS',
    industry: 'Restaurants & retail',
    category: 'POS platform & e-invoicing',
    img: '/shots/restopos.jpg',
    body: 'Our own ZATCA Phase 2 point-of-sale and billing platform — billing, kitchen tickets, reporting and Fatoora e-invoicing for restaurants, cafés, supermarkets and retail.',
    tags: ['Web', 'POS', 'ZATCA'],
  },
  {
    name: 'Baloot Al-Mamlaka',
    industry: 'Gaming',
    category: 'Mobile game (Arabic, RTL)',
    img: '/shots/baloot.jpg',
    body: 'A polished Arabic card-game experience with a fully right-to-left interface, custom visual identity and multiplayer-style presentation.',
    tags: ['Mobile', 'Arabic RTL', 'Game'],
  },
  {
    name: 'Mathbro',
    industry: 'Education',
    category: 'Learning web app',
    img: '/shots/mathbro.jpg',
    body: 'A math-practice product designed to feel like play — clean UX, progression and an engaging interface for learners.',
    tags: ['Web app', 'Education', 'UX'],
  },
  {
    name: 'DB Agent',
    industry: 'Software / AI',
    category: 'AI product',
    img: '/shots/agent.jpg',
    body: 'A personal AI agent product — interface, product design and engineering across the stack.',
    tags: ['AI', 'Product', 'Web'],
  },
  {
    name: 'DB Social',
    industry: 'Marketing',
    category: 'Content systems',
    img: '/shots/social.jpg',
    body: 'Content and growth systems built to help accounts scale — product and web execution.',
    tags: ['Web', 'Growth'],
  },
  {
    name: 'DB Studio',
    industry: 'Web',
    category: 'Custom websites',
    img: '/shots/site.jpg',
    body: 'Custom websites for founders and creators — fast, modern and built to convert.',
    tags: ['Websites', 'Design'],
  },
];
---

<Layout
  title="Our Work — RestoPOS"
  description="A selection of software RestoPOS has designed and built — the RestoPOS POS platform, mobile apps, web apps and AI products across industries."
>
  <div class="pb-8 pt-40">
    <section class="mx-auto max-w-6xl px-6 md:px-8">
      <div data-reveal>
        <p class="mb-5 text-[12px] uppercase tracking-[0.2em] text-gold">Our work</p>
        <h1 class="max-w-3xl text-balance text-display-lg font-extrabold text-bone">Software built for real businesses.</h1>
        <p class="mt-6 max-w-xl leading-relaxed text-bone/55">
          A selection of products we’ve designed and built — our own RestoPOS platform alongside
          custom apps, web products and AI tools across industries.
        </p>
      </div>
    </section>

    <section class="mx-auto mt-16 max-w-6xl px-6 md:px-8">
      <div class="grid gap-8 lg:grid-cols-2">
        {
          projects.map((p, i) => (
            <article data-reveal style={`--reveal-delay: ${(i % 2) * 0.1}s`} class="ease-out-quad group flex flex-col overflow-hidden rounded-3xl border border-hairline bg-charcoal-soft/40 transition-colors duration-500 hover:border-gold/30">
              <div class="overflow-hidden border-b border-hairline">
                <img src={p.img} width="2040" height="1230" loading="lazy" decoding="async" alt={`${p.name} — ${p.category}`} class="ease-out-quad aspect-[16/10] w-full object-cover object-top transition-transform duration-700 group-hover:scale-105" />
              </div>
              <div class="flex flex-1 flex-col p-8">
                <div class="flex items-center gap-3 text-[11px] uppercase tracking-widest text-bone/40">
                  <span class="text-gold">{p.industry}</span>
                  <span aria-hidden="true">·</span>
                  <span>{p.category}</span>
                </div>
                <h2 class="mt-3 text-xl font-semibold text-bone">{p.name}</h2>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-bone/55">{p.body}</p>
                <ul class="mt-5 flex flex-wrap gap-2 text-xs text-bone/60">
                  {p.tags.map((t) => <li class="rounded-md border border-hairline px-2.5 py-1">{t}</li>)}
                </ul>
              </div>
            </article>
          ))
        }
      </div>

      <p class="mt-10 max-w-xl text-xs leading-relaxed text-bone/35" data-reveal>
        Project availability and details shared with permission. Want something similar for your
        business? <a href="/contact" class="text-gold hover:underline">Tell us about it.</a>
      </p>
    </section>

    <div class="mt-28">
      <DemoCta />
    </div>
  </div>
</Layout>
